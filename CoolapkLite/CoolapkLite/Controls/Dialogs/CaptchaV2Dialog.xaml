<ContentDialog
    x:Class="CoolapkLite.Controls.Dialogs.CaptchaV2Dialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:CoolapkLite.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="/ContentDialog/CaptchaDialog"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    IsPrimaryButtonEnabled="False"
    mc:Ignorable="d">
    <WebView
        x:Name="WebView"
        VerticalAlignment="Center"
        DefaultBackgroundColor="Transparent"
        Loaded="{x:Bind SetWebViewHeight}"
        ScriptNotify="WebView_ScriptNotify"
        SizeChanged="{x:Bind SetWebViewHeight}" />
</ContentDialog>
