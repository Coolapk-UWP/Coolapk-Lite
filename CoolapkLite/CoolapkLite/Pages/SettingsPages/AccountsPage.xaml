<Page
    x:Class="CoolapkLite.Pages.SettingsPages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:CoolapkLite.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:CoolapkLite.Helpers"
    xmlns:local="using:CoolapkLite.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:network="using:CoolapkLite.Models.Network"
    xmlns:settingspages="using:CoolapkLite.ViewModels.SettingsPages"
    xmlns:ui="using:Microsoft.Toolkit.Uwp.UI"
    d:DataContext="{d:DesignInstance Type=settingspages:AccountsViewModel}"
    DataContext="{x:Bind Provider}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Grid>
        <control:PullToRefreshListView
            x:Name="ListView"
            x:Uid="/MainPage/ListView"
            helpers:ListViewHelper.Padding="{StaticResource ListViewPadding}"
            ui:ListViewExtensions.ItemContainerStretchDirection="Horizontal"
            ItemContainerStyle="{StaticResource SelectableCardItemStyle}"
            ItemsPanel="{Binding Template, Source={StaticResource ItemsPanelSelector}}"
            ItemsSource="{x:Bind Provider}"
            RefreshRequested="{x:Bind FrameworkElement_RefreshEvent}"
            SelectedIndex="{x:Bind Provider.SelectedIndex, FallbackValue='-1', Mode=TwoWay}"
            SelectionMode="Single"
            ShowsScrollingPlaceholders="False">
            <control:PullToRefreshListView.ItemTemplate>
                <DataTemplate x:DataType="settingspages:Credential">
                    <Grid Background="{ThemeResource SystemControlTransparentBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <control:AccountCard Margin="4,0,0,0" UID="{x:Bind UID}" />
                        <Button
                            x:Uid="/AccountsPage/RemoveAccount"
                            Grid.Column="1"
                            Content="&#xE74D;"
                            Style="{StaticResource TitleBarIconButtonStyle}">
                            <Button.Flyout>
                                <Flyout helpers:FlyoutBaseHelper.ShouldConstrainToRootBounds="False">
                                    <StackPanel>
                                        <TextBlock
                                            x:Uid="/AccountsPage/RemoveAccountTitle"
                                            Margin="0,0,0,12"
                                            Style="{ThemeResource BaseTextBlockStyle}" />
                                        <Button
                                            x:Name="RemoveAccount"
                                            x:Uid="/AccountsPage/RemoveAccountConfirm"
                                            Click="Button_Click"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </control:PullToRefreshListView.ItemTemplate>
        </control:PullToRefreshListView>
        <control:TitleBar
            x:Name="TitleBar"
            Title="{x:Bind Provider.Title}"
            DoubleTappedRequested="{x:Bind ListView.BackToTop}"
            IsRefreshButtonVisible="True"
            IsRefreshEnabled="True"
            RefreshRequested="{x:Bind FrameworkElement_RefreshEvent}">
            <Button
                x:Name="AddAccount"
                x:Uid="/AccountsPage/AddAccount"
                helpers:FocusVisualHelper.FocusVisualMargin="0"
                Click="Button_Click"
                Content="&#xE710;"
                Style="{StaticResource TitleBarIconButtonStyle}">
                <helpers:UIElementHelper.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="/AccountsPage/ExportAccount"
                            Click="MenuFlyoutItem_Click"
                            Tag="ExportAccount">
                            <helpers:FlyoutBaseHelper.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEDE1;" />
                            </helpers:FlyoutBaseHelper.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="/AccountsPage/ImportAccount"
                            Click="MenuFlyoutItem_Click"
                            Tag="ImportAccount">
                            <helpers:FlyoutBaseHelper.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B5;" />
                            </helpers:FlyoutBaseHelper.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </helpers:UIElementHelper.ContextFlyout>
            </Button>
        </control:TitleBar>
    </Grid>
</Page>
